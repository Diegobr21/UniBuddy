{
  "name": "unibuddy",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "dev:uni": "npm run dev -w apps/demo-uni",
    "build": "npm run build -w apps/web && npm run build -w apps/demo-uni",
    "check": "npm run check -w apps/web"
  }
}
