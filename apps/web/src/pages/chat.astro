---
import AppLayout from '../layouts/AppLayout.astro';
import Icon from '../components/Icon.astro';
import BottomNav from '../components/BottomNav.astro';
import Chat from '../components/Chat.tsx';
import { getUniversity, isMember } from '@unibuddy/data';
import { getSession } from '../lib/session';
import { serverEnv } from '../lib/env';
import { connectorUrl } from '../lib/uni-connectors';

const session = getSession(Astro.cookies);
const uni = getUniversity(session.universityId);
const member = isMember(session);

const roleLabel = {
  visitor: 'Visitor · public answers only',
  student: `Verified student · ${uni?.shortName}`,
  moderator: `Moderator · ${uni?.shortName}`,
  admin: `Admin · ${uni?.shortName}`,
}[session.role];

// Universities that publish an MCP server: the chat can also run their procedures
const connected = member && connectorUrl(session.universityId, serverEnv()) !== null;

const suggestions = connected
  ? ['Request my transcript in Spanish', 'Book office hours with Prof. Klein tomorrow', 'What are the upcoming deadlines?']
  : member
    ? ['How do people find a flat?', 'Getting my NIE / TIE', 'When should I start recruiting?']
    : ['How do people find a flat?', 'Student visa basics'];
---
<AppLayout title="Chat">
  <header class="topbar">
    <a href="/" class:list={['uni-badge', { 'uni-badge--member': member }]} aria-label="Change university">{uni?.shortName ?? 'All'}</a>
    <div class="topbar__title">
      <strong>MBA Buddy</strong>
      <span class:list={{ verified: member }}>{member && <Icon name="shield" size={14} />}{roleLabel}</span>
    </div>
    {!member && <a class="btn btn--primary sign-in" href={uni ? `/sign-in?uni=${uni.id}` : '/'}>Sign in</a>}
  </header>

  <div class="notice-wrap">
    <p class="notice"><Icon name="info" size={16} />You are chatting with an AI assistant. Answers come from verified student stories.</p>
    {connected && (
      <p class="notice connected"><Icon name="check" size={16} />Connected to {uni?.name}: the assistant can also prepare procedures for you to confirm.</p>
    )}
  </div>

  <main class="chat-main">
    <Chat client:load suggestions={suggestions} universityName={uni?.shortName ?? null} isMember={member} signInHref={uni ? `/sign-in?uni=${uni.id}` : '/'} />
  </main>

  {member && <BottomNav current="chat" />}
</AppLayout>

<style>
  .uni-badge {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--surface-2);
    color: var(--ink-3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 12px;
    text-decoration: none;
  }
  .uni-badge--member {
    background: var(--red-pale);
    color: var(--red);
  }
  .verified {
    color: var(--red) !important;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .sign-in {
    min-height: 40px;
    border-radius: 12px;
    font-size: 14px;
  }
  .notice-wrap {
    padding: 12px 20px 0;
  }
  .notice {
    margin: 0;
  }
  .connected {
    margin-top: 8px;
    background: var(--ok-pale);
    color: var(--ok);
  }
  :global(.action) {
    gap: 12px;
    border: 1px solid var(--red);
  }
  :global(.action__head) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  :global(.action__buttons) {
    display: flex;
    gap: 10px;
  }
  :global(.action__buttons .btn) {
    flex: 1;
  }
  :global(.action__buttons .btn--primary) {
    flex: 2;
  }
  :global(.action__ok) {
    background: var(--ok-pale);
    color: var(--ok);
  }
  :global(.action__error) {
    background: var(--warn-pale);
    color: var(--warn);
  }
  :global(.action select:disabled),
  :global(.action input:disabled) {
    background: var(--surface-2);
    color: var(--ink-2);
  }
  .chat-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 16px 20px 12px;
  }
  :global(.chat) {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  :global(.chat__messages) {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  :global(.chat__empty) {
    margin: 0;
    color: var(--ink-3);
    font-size: 15px;
    line-height: 1.5;
  }
  :global(.chat__answer) {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  :global(.bubble) {
    max-width: 88%;
    padding: 12px 14px;
    font-size: 15px;
    line-height: 1.5;
  }
  :global(.bubble p) {
    margin: 0 0 10px;
    white-space: pre-line;
  }
  :global(.bubble--student) {
    align-self: flex-end;
    border-radius: 16px 16px 4px 16px;
    background: var(--red);
    color: var(--white);
  }
  :global(.bubble--assistant) {
    align-self: flex-start;
    border-radius: 16px 16px 16px 4px;
    background: var(--white);
    border: 1px solid var(--border);
  }
  :global(.locked .btn) {
    min-height: 44px;
  }
  :global(.handoff) {
    flex-direction: row;
    align-items: center;
    gap: 12px;
    color: var(--red-deep);
  }
  :global(.handoff__text) {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    color: var(--ink);
    font-size: 13px;
  }
  :global(.handoff__btn) {
    min-height: 40px;
    font-size: 13px;
    border-radius: 10px;
  }
  :global(.chat__composer) {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 6px 6px 14px;
    border-radius: 16px;
    background: var(--white);
    border: 1px solid var(--border-2);
  }
  :global(.chat__composer input) {
    flex: 1;
    border: 0;
    outline: none;
    font: 400 16px var(--font);
    background: transparent;
  }
  :global(.chat__send) {
    width: 44px;
    min-height: 44px;
    padding: 0;
    border-radius: 12px;
  }
  :global(.chat__send:disabled),
  :global(.chip:disabled) {
    opacity: 0.5;
    cursor: default;
  }
</style>
