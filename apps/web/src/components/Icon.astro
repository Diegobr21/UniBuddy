---
// Stroke icons used across the screens. Decorative: hidden from screen readers (the text next to them says it all).
interface Props {
  name: 'chat' | 'edit' | 'shield' | 'back' | 'send' | 'lock' | 'globe' | 'check' | 'info' | 'person' | 'star' | 'download' | 'plus' | 'search' | 'book' | 'chevron';
  size?: number;
  color?: string;
}
const { name, size = 20, color = 'currentColor' } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke={color} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'chat' && <path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z" />}
  {name === 'edit' && <><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" /></>}
  {name === 'shield' && <><path d="M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6z" /><path d="M9 12l2 2 4-4" /></>}
  {name === 'back' && <path d="M15 18l-6-6 6-6" />}
  {name === 'send' && <><path d="M5 12h14" /><path d="M13 6l6 6-6 6" /></>}
  {name === 'lock' && <><rect x="5" y="11" width="14" height="9" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></>}
  {name === 'globe' && <><circle cx="12" cy="12" r="9" /><path d="M3 12h18" /><path d="M12 3a14 14 0 0 1 0 18" /><path d="M12 3a14 14 0 0 0 0 18" /></>}
  {name === 'check' && <path d="M5 12l5 5 9-10" />}
  {name === 'info' && <><circle cx="12" cy="12" r="9" /><path d="M12 8v5" /><path d="M12 16h.01" /></>}
  {name === 'person' && <><circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" /></>}
  {name === 'star' && <path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z" />}
  {name === 'download' && <><path d="M12 3v12" /><path d="M7 10l5 5 5-5" /><path d="M5 21h14" /></>}
  {name === 'plus' && <><path d="M12 5v14" /><path d="M5 12h14" /></>}
  {name === 'search' && <><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></>}
  {name === 'book' && <path d="M4 19V5a2 2 0 0 1 2-2h12v16H6a2 2 0 0 0-2 2z" />}
  {name === 'chevron' && <path d="M6 9l6 6 6-6" />}
</svg>
