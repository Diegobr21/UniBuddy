# Copy this file to apps/web/.env and fill in what you have. Everything is optional:
# without keys the prototype still works with simpler fallbacks.

# Chat answers with an AI model (without it: answers straight from the stories)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Jev (TypeSafe) checks every new story before the moderator sees it (without it: simple rules)
JEV_API_KEY=
# Optional. Default: https://api.typesafe.ai/v1/systemone
JEV_API_URL=
# Optional. Default: jev-latest
JEV_MODEL=
